# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase > Project Settings > Database > Connection string > "Session pooler" (IPv4).
# Replace <password> with your database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Google AI Studio > Get API key (free tier)
GEMINI_API_KEY=

# Model names change over time; check https://ai.google.dev/gemini-api/docs/models
# Comma-separated lists: when a model hits its free-tier daily cap, the next one is used.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.1-flash-lite
GEMINI_TRIAGE_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_ANSWER_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
# How much the answer model "thinks" first: minimal, low, medium, high (lower is faster)
GEMINI_ANSWER_THINKING=low
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Free-tier embedding limits are per minute; requests are split and paced to stay under them
EMBED_TOKENS_PER_MINUTE=25000
EMBED_BATCH_TOKENS=12000
# Minimum gap between LLM calls, to stay under the free-tier requests-per-minute limit
LLM_MIN_INTERVAL_SECONDS=4

# Ingestion
LOOKBACK_HOURS=48
FETCH_TIMEOUT_SECONDS=20
USER_AGENT=ConstructiveNewsAI/0.1 (student capstone project)
